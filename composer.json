{
  "name": "webship/webship",
  "description": "The Webship.co portal site was built on top of Drupal, as it has many options, tools, frameworks, and configuration management, which are needed in building solutions.",
  "type": "drupal-profile",
  "license": "GPL-2.0-or-later",
  "support": {
    "issues": "http://drupal.org/project/issues/webship",
    "source": "http://cgit.drupalcode.org/webship"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "authors": [
    {
      "name": "webship.co",
      "homepage": "https://www.drupal.org/webship",
      "role": "Maintainer"
    }
  ],
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "assets": {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  },
  "require": {
    "composer/installers": "~2",
    "oomphinc/composer-installers-extender": "~2",
    "drupal/core-composer-scaffold": "~11",
    "drupal/core": "~11.2.0",
    "drush/drush": "~13",
    "drupal/webpatches": "~11.0.0",
    "drupal/webconfig": "~11.0.0",
    "drupal/webdev": "~11.0.0",
    "drupal/webadmin": "~11.0.0",
    "drupal/websecurity": "~11.0.0",
    "drupal/webeditor": "~11.0.0",
    "drupal/webseo": "~11.0.0",
    "drupal/webpage": "~11.0.0",
    "drupal/webtheme": "~11.0.0",
    "drupal/webassets": "~11.0.0",
    "drupal/webblog": "~11.0.0",
    "drupal/webreleases": "~11.0.0",
    "drupal/webdoc": "~11.0.0",
    "drupal/webnewsletter": "~11.0.0",
    "drupal/webshare": "~1.0.0",
    "drupal/webform": "~6.3.0"
  }
}